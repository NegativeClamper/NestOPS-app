# Mobile app environment variables
# Expo reads variables prefixed with EXPO_PUBLIC_ at build/start time

# Your PC's local IP (Metro server IP shown when you ran `npx expo start`)
# For Android physical device on same WiFi:
EXPO_PUBLIC_API_URL=http://192.168.29.176:8000/api

# For Android emulator (use this instead if running in emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
